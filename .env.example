# Required for deployment. For a public website, replace 6387 with a long secret.
ADMIN_PASSCODE=6387
PORT=3100
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3100
# Generate both VAPID keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Apple Developer > Keys > APNs auth key (.p8), added only on your host server.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_BUNDLE_ID=com.example.BattleOfRah
APNS_KEY_FILE=
APNS_ENV=sandbox
# Override with persistent volume path on a host, e.g. /var/data/rah
DATA_DIR=
